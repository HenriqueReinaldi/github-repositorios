        <div class="cartao_repo">
            <div class="titulo_repo">
                <a href="${repo.link}">[${repo.nome}] ↗</a>
                <div>[${repo.forks}f]</div>
                <div>[${repo.stars}*]</div>
                <div style="color:#000000">[${repo.language}]</div>
